# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/tokens_burned

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of trusted origins for auth API calls.
# Required when BETTER_AUTH_URL host differs from the actual client host
# (e.g. accessing the app via LAN IP like http://192.168.6.74:3000 or
# behind a reverse proxy on https://app.example.com). better-auth
# rejects login / register / logout requests from origins not in this list.
# BETTER_AUTH_URL, http://localhost:3000, and http://127.0.0.1:3000 are
# always trusted. Set BETTER_AUTH_LAN_ORIGIN to a single additional
# non-localhost host (e.g. http://192.168.6.74:3000) for LAN deployments.
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_LAN_ORIGIN=

# Auth Mode (self-hosted | production)
# - self-hosted: Email/password authentication only (for self-deployed instances)
# - production: OAuth-only authentication (Discord/GitHub/Google/Linux.do/Watcha, for cloud-hosted service)
AUTH_MODE=self-hosted

# OAuth Providers (required only when AUTH_MODE=production)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_BASE_URL=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
WATCHA_CLIENT_ID=
WATCHA_CLIENT_SECRET=

# GitLab OAuth setup (self-hosted or gitlab.com)
# Example base URL: https://gitlab.com or https://gitlab.example.com
# Redirect URI: http://localhost:3000/api/auth/oauth2/callback/gitlab

# Discord OAuth2 setup
# Redirect URI (local): http://localhost:3000/api/auth/callback/discord
# Recommended scopes: identify email

# PostgreSQL (for docker-compose reference)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tokens_burned

# Google Analytics (optional; omit to disable)
# GA_SECRET=G-XXXXXXXXXX

# Microsoft Clarity (optional; omit to disable)
# CLARITY_ID=your-project-id

# Wechat Share
NEXT_PUBLIC_APP_ORIGIN=https://your-domain.com
WECHAT_OPEN_APP_ID=wx1234567890abcdef
WECHAT_OPEN_APP_SECRET=xxxxxxxxxxxxxxxx

# Admin allowlist (comma-separated usernames)
# Users in this list can view any other user's full usage dashboard at /u/[username].
# Leave empty to disable the admin cross-user view entirely.
# Usernames are matched case-insensitively after the comma split.
# Restart next dev / container after changing.
ADMIN_USERNAMES=

# Inactivity Email Reminders (worker service)
# Configure SMTP to enable the worker to email users who have been inactive
# for 3+ business days (CN holidays + weekends excluded). Leave SMTP_HOST
# empty to disable reminder emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Token Arena <noreply@tokenarena.example>"
